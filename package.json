{
  "name": "activities-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs",
    "enrich": "node scripts/enrich-exercises.mjs",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist --project-name=activities-lab --branch=production --commit-dirty=true",
    "build:gh-pages": "tsc -b && vite build --mode gh-pages",
    "deploy:gh-pages": "npm run build:gh-pages && npx --yes gh-pages -d dist -t"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.1.0",
    "dexie": "^4.4.4",
    "dexie-export-import": "^4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.0",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
